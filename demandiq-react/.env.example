# Copy this file to .env.local and change what you need, then restart `npm run dev`.

# Who answers the app's API requests:
#   demo  (default) the demo backend that runs in the browser (src/services/mock) — no server needed
#   live  the FastAPI backend at VITE_API_URL
VITE_API_MODE=live

# Where FastAPI is (live mode). /api is forwarded to http://localhost:8000 by vite.config.js.
# For a backend on another origin use its full URL, e.g. http://localhost:8000/api (then enable CORS there).
VITE_API_URL=/api

# Demo mode only: pretend network delay in milliseconds, so loading states are visible. 0 = none.
VITE_DEMO_LATENCY_MS=250
