# DemandIQ FastAPI backend — copy to backend/.env and fill in. Never commit a real .env.

# --- Microsoft SQL Server ----------------------------------------------------------------------
# Either the parts below …
MSSQL_SERVER=localhost
MSSQL_PORT=1433
MSSQL_DATABASE=B1A-S6-T3
MSSQL_USER=
MSSQL_PASSWORD=
MSSQL_DRIVER=ODBC Driver 17 for SQL Server
# true = Windows authentication (leave MSSQL_USER / MSSQL_PASSWORD empty); named instance: MSSQL_SERVER=localhost\SQLEXPRESS and MSSQL_PORT=
MSSQL_TRUSTED_CONNECTION=true
# Local / self-signed servers; set false when the server has a trusted certificate
MSSQL_TRUST_SERVER_CERTIFICATE=true
# … or one SQLAlchemy URL, which wins over the parts (e.g. for Azure SQL):
# DATABASE_URL=mssql+pyodbc://user:password@server.database.windows.net:1433/DemandIQ?driver=ODBC+Driver+18+for+SQL+Server
DB_ECHO=false

# --- Sessions ----------------------------------------------------------------------------------
SESSION_HOURS=8
REMEMBER_DAYS=7
BCRYPT_ROUNDS=12

# --- HTTP --------------------------------------------------------------------------------------
# Origins allowed to call the API from a browser (comma-separated). Not needed when Vite proxies /api.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
MAX_UPLOAD_MB=50

# --- Reports and email -------------------------------------------------------------------------
# Where generated report files are kept (created if missing)
# REPORTS_DIR=./storage/reports
APP_TIMEZONE=Asia/Kolkata
# SMTP for "Email report". Without SMTP_HOST the request is recorded but no email is sent.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=DemandIQ <no-reply@demandiq.local>
SMTP_STARTTLS=true
